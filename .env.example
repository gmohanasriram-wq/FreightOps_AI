# FreightOps AI Environment Configuration (Contract 2.2 Baseline)
# Copy this file to `.env` and replace every change-me value.
# `.env` is ignored by Git and must never be committed.
PROJECT_NAME="FreightOps AI"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8000

# PostgreSQL Configuration (required; no credential fallbacks are used)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="change-me"
POSTGRES_PASSWORD="change-me-in-your-local-env"
POSTGRES_DB="freightops"
# Optional full connection URI override. When set, it takes precedence over the
# component values above. Credentials in this value must not be committed.
# DATABASE_URL="postgresql://change-me:change-me@localhost:5432/freightops"
DB_CONNECT_TIMEOUT_SECONDS=3

# Demo-user seeding (optional). Seeding is skipped unless every role below has
# both an email and a password set. Leave blank to disable demo seeding.
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""
DEMO_BROKER_EMAIL=""
DEMO_BROKER_PASSWORD=""
DEMO_VIEWER_EMAIL=""
DEMO_VIEWER_PASSWORD=""

# Frontend CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
